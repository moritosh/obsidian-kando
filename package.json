{
  "name": "obsidian-kando",
  "version": "1.1.0",
  "description": "Create markdown-backed Kanban boards in Obsidian.",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noemit",
    "test": "vitest run",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint ./src/**/*.{ts,tsx}",
    "lint:fix": "eslint ./src/**/*.{ts,tsx} --fix",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "yarn prettier && yarn lint:fix",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && yarn rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "moritosh",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/box-intersect": "^1.0.0",
    "@types/mark.js": "^8.11.5",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-less": "^1.3.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.33.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "magic-string": "^1.1.0",
    "moment": "^2.30.1",
    "obsidian": "^1.5.7-1",
    "obsidian-dataview": "^0.5.66",
    "obsidian-plugin-cli": "^0.9.0",
    "prettier": "^3.1.1",
    "tslib": "^2.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "^8.15.1",
    "@tanstack/react-table": "^8.11.2",
    "box-intersect": "^1.0.2",
    "choices.js": "11.2.3",
    "colord": "^2.9.3",
    "eventemitter3": "^5.0.1",
    "file-selector": "^4.0.2",
    "immutability-helper": "^3.1.1",
    "mark.js": "^8.11.1",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-to-string": "^4.0.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-types": "^2.0.2",
    "monkey-around": "^3.0.0",
    "obsidian-daily-notes-interface": "^0.9.4",
    "preact": "^10.8.2",
    "react": "npm:@preact/compat",
    "react-colorful": "^5.6.1",
    "react-cool-onclickoutside": "^1.6.1",
    "react-dom": "npm:@preact/compat",
    "rrule": "^2.8.1",
    "unist-util-visit": "^5.1.0"
  },
  "importSort": {
    ".js, .ts, .tsx": {
      "style": "module-alias",
      "options": {
        "alias": [
          "src"
        ]
      }
    }
  }
}
