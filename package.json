{
  "name": "obsidian-kando",
  "version": "1.1.0",
  "description": "Create markdown-backed Kanban boards in Obsidian.",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noemit",
    "test": "vitest run",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint ./src/**/*.{ts,tsx}",
    "lint:fix": "eslint ./src/**/*.{ts,tsx} --fix",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "pnpm prettier && pnpm lint:fix",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && pnpm rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "moritosh",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/box-intersect": "1.0.3",
    "@types/mark.js": "8.11.12",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "builtin-modules": "5.4.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-less": "1.3.39",
    "eslint": "10.13.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "magic-string": "1.4.3",
    "moment": "2.31.0",
    "obsidian": "1.14.4",
    "obsidian-dataview": "0.5.68",
    "obsidian-plugin-cli": "0.9.0",
    "prettier": "3.9.10",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-table": "9.3.1",
    "box-intersect": "1.0.2",
    "choices.js": "11.2.4",
    "colord": "2.10.0",
    "eventemitter3": "5.0.4",
    "file-selector": "5.0.1",
    "immutability-helper": "3.1.1",
    "mark.js": "8.11.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.3",
    "monkey-around": "3.0.0",
    "obsidian-daily-notes-interface": "0.9.5",
    "preact": "11.0.1",
    "react": "npm:@preact/compat@18.3.2",
    "react-colorful": "5.8.1",
    "react-cool-onclickoutside": "1.7.0",
    "react-dom": "npm:@preact/compat@18.3.2",
    "rrule": "2.8.1",
    "unist-util-visit": "5.1.0"
  },
  "importSort": {
    ".js, .ts, .tsx": {
      "style": "module-alias",
      "options": {
        "alias": [
          "src"
        ]
      }
    }
  }
}
